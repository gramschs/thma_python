":"text","value":", den ","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"PV66RAejOn"},{"type":"inlineCode","value":"np.corrcoef()","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"KdFWMLOqyw"},{"type":"text","value":"\nliefert. Der Rückgabewert ist eine 2×2-Matrix; der Korrelationskoeffizient\nsteht an Position ","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"dE2dOS7hRY"},{"type":"inlineCode","value":"[0, 1]","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"uijczCG2Zd"},{"type":"text","value":":","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"mgb3jngU2Y"}],"key":"hXSOOnAiwC"}],"key":"YckKXyd1Hs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Eingabe und Verarbeitung wie oben\ndf = pd.read_csv(\"autoscout24_DE_2020_cleaned.csv\")\ndf_benzin = df[(df[\"Kraftstoff\"] == \"Benzin\") &\n               (df[\"Preis (Euro)\"] <= 100000)].dropna(subset=[\"Leistung (kW)\",\n                                                               \"Preis (Euro)\"])\nx = df_benzin[\"Leistung (kW)\"].values\ny = df_benzin[\"Preis (Euro)\"].values\n\n# Verarbeitung\nr = np.corrcoef(x, y)[0, 1]\nR2 = r**2\n\n# Ausgabe\nprint(f\"r  = {r:.3f}\")\nprint(f\"R² = {R2:.3f}\")","key":"iZA92TevmK"},{"type":"outputs","id":"SSHww7IGbyOpu7Gsqts0b","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"r  = 0.864\nR² = 0.746\n"},"key":"lB3Wkw2nw4"}],"key":"DPc9PFS2Ud"}],"key":"qDP96qcDJu"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":177,"column":1},"end":{"line":179,"column":1}},"children":[{"type":"text","value":"R² ≈ 0.75 bedeutet: Die Motorleistung erklärt 75 % der Preisstreuung. Das ist\nein starker linearer Zusammenhang, aber 25 % der Variation bleiben durch andere\nFaktoren wie Marke, Ausstattung oder Kilometerstand unbeschrieben.","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"ipScQuAmWD"}],"key":"czgJ4EiMb3"},{"type":"heading","depth":3,"position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"children":[{"type":"text","value":"Hohe Korrelation ist keine Kausalität","position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"YLRyPrJ2Ox"}],"identifier":"hohe-korrelation-ist-keine-kausalit-t","label":"Hohe Korrelation ist keine Kausalität","html_id":"hohe-korrelation-ist-keine-kausalit-t","implicit":true,"key":"BuHLBuvams"},{"type":"paragraph","position":{"start":{"line":183,"column":1},"end":{"line":186,"column":1}},"children":[{"type":"text","value":"Als weiteres Beispiel berechnen wir R² für den Zusammenhang zwischen\nKraftstoffverbrauch in l/100 km und CO₂-Ausstoß in g/km. Wir filtern auf\nphysikalisch plausible Werte, da der Rohdatensatz vereinzelte Fehleingaben\nenthält:","position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"key":"sgrtDyWp24"}],"key":"EZGszVA759"}],"key":"XkYfBJwyA4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Eingabe\ndf_verbrauch = df[(df[\"Kraftstoff\"] == \"Benzin\") &\n                  (df[\"Verbrauch (l/100 km)\"] >= 3) &\n                  (df[\"Verbrauch (l/100 km)\"] <= 20) &\n                  (df[\"Verbrauch (g/km)\"] >= 70) &\n                  (df[\"Verbrauch (g/km)\"] <= 470)].dropna(\n                      subset=[\"Verbrauch (l/100 km)\", \"Verbrauch (g/km)\"])\n\nx_v = df_verbrauch[\"Verbrauch (l/100 km)\"].values\ny_v = df_verbrauch[\"Verbrauch (g/km)\"].values\n\n# Verarbeitung\nr_v = np.corrcoef(x_v, y_v)[0, 1]\nkoeff_v = np.polyfit(x_v, y_v, 1)\n\n# Ausgabe\nprint(f\"R² = {r_v**2:.3f}\")\nprint(f\"Steigung: {koeff_v[0]:.2f} g/km pro l/100 km\")","key":"HW1YGhMUBw"},{"type":"outputs","id":"g4B-DOtCM5jqf4zO_7zud","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"R² = 0.963\nSteigung: 22.47 g/km pro l/100 km\n"},"key":"H675iECpqK"}],"key":"zPBsMZ15xn"}],"key":"XSNoiYv8sM"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":209,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"R² ≈ 0.96 ist eine sehr hohe Korrelation. Die Steigung von etwa 22.5 g/km pro\nl/100 km entspricht dem physikalischen Umrechnungsfaktor für Benzin: Jeder\nverbrannte Liter Kraftstoff erzeugt eine feste Menge CO₂.","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"xjiy0Ruhhw"}],"key":"yD23Q3wTAY"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Korrelation und Kausalität","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"gYlBYILZ1f"}],"key":"l70HGJIj18"},{"type":"paragraph","position":{"start":{"line":215,"column":1},"end":{"line":220,"column":1}},"children":[{"type":"text","value":"Beide Größen messen dieselbe physikalische Ursache: die Verbrennung von\nKraftstoff. Das hohe R² zeigt die enge Verwandtschaft, sagt aber nichts darüber\naus, welche Größe die andere verursacht. Würde man durch eine Gesetzgebung den\nCO₂-Wert in den Fahrzeugdaten auf null setzen, sänke der Kraftstoffverbrauch\ndadurch nicht um einen Milliliter. Hohe Korrelation bedeutet immer nur, dass\nzwei Größen zusammenhängen, nie dass eine die andere bewirkt.","position":{"start":{"line":215,"column":1},"end":{"line":215,"column":1}},"key":"GyeSbg5SNr"}],"key":"jQj5NvYwaK"}],"class":"caution","key":"OVzCqDWxnf"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Mini-Übung","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"AIZPP9v3Aj"}],"key":"OtiHzGkpfS"},{"type":"paragraph","position":{"start":{"line":225,"column":1},"end":{"line":227,"column":1}},"children":[{"type":"tex